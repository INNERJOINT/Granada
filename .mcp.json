{
  "mcpServers": {
    "sourcepilot": {
      "type": "http",
      "url": "${SOURCEPILOT_URL:-http://10.23.12.96:8888/mcp}",
      "headers": {
        "Authorization": "Bearer ${SOURCEPILOT_KEY:-sk-abc123}"
      }
    },
    "gitlab": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@zereight/mcp-gitlab"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${GITLAB_PERSONAL_ACCESS_TOKEN}",
        "GITLAB_API_URL": "${GITLAB_API_URL:-https://gitlab.gz.cvte.cn/api/v4}"
      }
    }
  }
}
